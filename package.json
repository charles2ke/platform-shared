{
  "name": "@charles2ke/platform-shared",
  "version": "0.2.0",
  "description": "Shared, dependency-free platform foundations for auth, profiles, and notifications.",
  "keywords": [
    "auth",
    "jwt",
    "kafka",
    "kubernetes",
    "mongodb",
    "notifications",
    "observability",
    "platform",
    "profile",
    "rbac",
    "redis",
    "transcoding"
  ],
  "homepage": "https://charles2ke.github.io/platform-shared/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charles2ke/platform-shared.git"
  },
  "bugs": {
    "url": "https://github.com/charles2ke/platform-shared/issues"
  },
  "author": "charles2ke",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./adapters": {
      "types": "./types/adapters/index.d.ts",
      "default": "./src/adapters/index.js"
    },
    "./auth": {
      "types": "./types/auth/index.d.ts",
      "default": "./src/auth/index.js"
    },
    "./cache": {
      "types": "./types/cache/index.d.ts",
      "default": "./src/cache/index.js"
    },
    "./media": {
      "types": "./types/media/index.d.ts",
      "default": "./src/media/index.js"
    },
    "./notifications": {
      "types": "./types/notifications/index.d.ts",
      "default": "./src/notifications/index.js"
    },
    "./package.json": "./package.json",
    "./profile": {
      "types": "./types/profile/index.d.ts",
      "default": "./src/profile/index.js"
    },
    "./runtime": {
      "types": "./types/runtime/index.d.ts",
      "default": "./src/runtime/index.js"
    },
    "./shared": {
      "types": "./types/shared/index.d.ts",
      "default": "./src/shared/index.js"
    },
    "./storage": {
      "types": "./types/storage/index.d.ts",
      "default": "./src/storage/index.js"
    },
    "./streaming": {
      "types": "./types/streaming/index.d.ts",
      "default": "./src/streaming/index.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "deploy",
    "src",
    "types"
  ],
  "scripts": {
    "build": "node scripts/check-syntax.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "check": "npm run build && npm test && npm run check:types",
    "audit": "npm audit --omit=dev --audit-level=high",
    "types": "tsc -p tsconfig.types.json",
    "check:types": "npm run types && tsc -p tsconfig.check.json",
    "prepare": "node -e \"try { require.resolve('typescript'); } catch { process.exit(0); } require('node:child_process').execSync('npm run types', { stdio: 'inherit' });\""
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
