# Required in production. Use at least 32 random characters.
PLATFORM_JWT_SECRET=replace-with-a-32-character-minimum-secret

# Optional auth metadata and token TTLs.
PLATFORM_JWT_ISSUER=platform-shared
PLATFORM_JWT_AUDIENCE=social
PLATFORM_JWT_ACCESS_TTL_SECONDS=900
PLATFORM_JWT_REFRESH_TTL_SECONDS=2592000

# Optional shared defaults.
PLATFORM_DEFAULT_LOCALE=en-US
PLATFORM_DEFAULT_TIMEZONE=UTC
PLATFORM_DEFAULT_FROM_EMAIL=no-reply@example.com
PLATFORM_DEFAULT_SMS_SENDER=Platform
PLATFORM_DEFAULT_PUSH_SENDER=Platform
